{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "./AGENTS.md"
  ],
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:PAT_MCP_TESTE_AUTOMATIZADO}",
        "X-MCP-Toolsets": "all"
      }
    },
  }
}
