{
  "Documento TDD": {
    "scope": "typescript",
    "prefix": "docpagina",
    "description": "Documento modular do portal TDD; registre uma vez no catálogo.",
    "body": [
      "import type { IDocumento } from '../../models/documentacao.ts';",
      "",
      "export default {",
      "  slug: '${1:novo-caso}', categoria: '${2|estrutura,guias,documentos|}',",
      "  titulo: '${3:Título da documentação}',",
      "  resumo: '${4:Objetivo e conteúdo da página.}',",
      "  navegacao: { grupo: '${9|estrutura,guias,casos|}', ordem: ${10:0} },",
      "  estado: 'em-desenvolvimento',",
      "  fontes: [{ caminho: '${5:docs/assets/caminho/UNIT.pas}' }],",
      "  secoes: [{",
      "    id: '${6:objetivo}', titulo: '${7:Objetivo e pré-requisitos}', nivel: 2,",
      "    blocos: [{ tipo: 'paragrafo', texto: '${8:Descreva objetivo, fluxo e limites do caso.}' }]",
      "  }]",
      "} satisfies IDocumento;",
      "$0"
    ]
  },
  "Seção documental": {
    "scope": "typescript",
    "prefix": "docsecao",
    "description": "Seção reutilizável com ID único no documento.",
    "body": [
      "{",
      "  id: '${1:fluxo}', titulo: '${2:Fluxo de execução}', nivel: ${3|2,3,4|},",
      "  blocos: [{ tipo: 'paragrafo', texto: '${4:Explique o fluxo.}' }]",
      "},$0"
    ]
  },
  "Código literal": {
    "scope": "typescript",
    "prefix": "doccodigo",
    "description": "Bloco de código selecionável com botão de cópia.",
    "body": [
      "{ tipo: 'codigo', linguagem: '${1|pascal,json,typescript,javascript,shell|}',",
      "  codigo: `${2:Conteúdo literal do código}` },$0"
    ]
  },
  "Tabela documental": {
    "scope": "typescript",
    "prefix": "doctabela",
    "description": "Tabela com o mesmo número de células por linha.",
    "body": [
      "{ tipo: 'tabela',",
      "  colunas: ['${1:Unit}', '${2:Responsabilidade}'],",
      "  linhas: [['${3:P39_TDD_STARTED}', '${4:Preparar o caso corrente}']]",
      "},$0"
    ]
  },
  "Diagrama canônico": {
    "scope": "typescript",
    "prefix": "docdiagrama",
    "description": "Referência a um fence Mermaid em Markdown, sem duplicar o mapa.",
    "body": [
      "{ tipo: 'mermaid', fonte: 'docs/MAPEAMENTO_AST_USES_UNITS/${1:documentacao}/${2:fluxo}.md',",
      "  titulo: '${3:Dependências diretas e transitivas}' },$0"
    ]
  },
  "Documento individual de unit": {
    "scope": "typescript",
    "prefix": "docunit",
    "description": "Unit canônica: mesmo nome P39_TDD_ no fonte, título, menu e rota.",
    "body": [
      "import { criarDocumentoUnit } from './criarDocumentoUnit.ts';",
      "export default criarDocumentoUnit({",
      "  nome: '${1:P39_TDD_NOVA_UNIT}',",
      "  navegacao: { grupo: 'units', subgrupo: '${2|setup,constantes,persistencia,irunner|}', ordem: ${3:0} },",
      "  estado: 'em-desenvolvimento',",
      "  resumo: '${4:Responsabilidade principal da unit.}',",
      "  fonte: '${5:docs/assets/caminho}/${1}.pas',",
      "  responsabilidade: '${6:O que esta unit deve realizar.}',",
      "  problema: '${7:Qual problema ela resolve.}',",
      "  estados: [['${8:ESTADO: Tipo}', '${9:Finalidade}', '${10:Inicialização, alteração e descarte}']],",
      "  metodos: [['${11:procedure Executar;}', '${12:Finalidade e contrato}', '${13:Como está implementada}']],",
      "  implementacao: ['${14:Etapas internas e decisões}'],",
      "  dependencias: ['${15:P39_TDD_IRUNNER}: ${16:Motivo da dependência}'],",
      "  limites: ['${17:Limitações verificadas nos fontes}']",
      "});",
      "$0"
    ]
  },
  "Método da unit": {
    "scope": "typescript",
    "prefix": "docunitmetodo",
    "description": "Procedure/function: assinatura Pascal, contrato e implementação.",
    "body": [
      "['${1:function Consultar(ID: Integer): String;}',",
      " '${2:Entradas, retorno, efeitos e erros}',",
      " '${3:Passos da implementação e dependências}'],$0"
    ]
  },
  "Estado global da unit": {
    "scope": "typescript",
    "prefix": "docunitestado",
    "description": "Estado global: nome, finalidade e ciclo de vida.",
    "body": [
      "['${1:ESTADO_GLOBAL}', '${2:Tipo e finalidade}', '${3:Quem inicializa, altera e limpa}'],$0"
    ]
  },
  "Registro de unit": {
    "scope": "typescript",
    "prefix": "docregistrounit",
    "description": "Import em content/units/catalogo.ts; use o nome canônico do arquivo TypeScript.",
    "body": [
      "import ${1:novaUnit} from './${2:p39-tdd-nova-unit}.ts';",
      "// Acrescente ${1:novaUnit} à lista units abaixo.",
      "$0"
    ]
  },
  "Aviso documental": {
    "scope": "typescript",
    "prefix": "docaviso",
    "description": "Aviso técnico visível na documentação.",
    "body": [
      "{ tipo: 'aviso', severidade: '${1|info,warning,error,success|}', texto: '${2:Limitação ou observação}' },$0"
    ]
  },
  "Lista documental": {
    "scope": "typescript",
    "prefix": "doclista",
    "description": "Lista de responsabilidades, etapas ou referências de units.",
    "body": [
      "{ tipo: 'lista', itens: ['${1:Primeiro item}', '${2:Segundo item}'] },$0"
    ]
  },
  "Fonte Mermaid em Markdown": {
    "scope": "markdown",
    "prefix": "docmermaid",
    "description": "Salve em docs/MAPEAMENTO_AST_USES_UNITS/<slug>/<diagrama>.md e referencie com docdiagrama.",
    "body": [
      "# ${1:Título do diagrama}",
      "",
      "Documentação: ${2:Assunto}. Fonte canônica do diagrama.",
      "",
      "```mermaid",
      "flowchart ${3|LR,TD|}",
      "  A[\"${4:P39_TDD_IRUNNER}\"] --> B[\"${5:P39_TDD_RUNNER}\"]",
      "```",
      "$0"
    ]
  },
  "Registro do documento": {
    "scope": "typescript",
    "prefix": "docregistro",
    "description": "Import para catalogo.ts; acrescente o identificador à lista documentos.",
    "body": [
      "import ${1:novaPagina} from './${2:estrutura/novo-fluxo}.ts';",
      "// Acrescente ${1:novaPagina} à lista documentos abaixo.",
      "$0"
    ]
  },
  "JSON base do caso de teste": {
    "scope": "typescript",
    "prefix": "docunitjson",
    "description": "Inclua em criarDocumentoUnit de um caso: JSON copiável, tabela e fontes das tags.",
    "body": [
      "jsonBase: {",
      "  exemplo: { ${1:objeto}: { ${2:campo}: 0 } },",
      "  campos: [",
      "    ['${1:objeto}', 'objeto', '${3:Finalidade do objeto}', '${4:Impacto no teste}'],",
      "    ['${1:objeto}.${2:campo}', 'número', '${5:Finalidade do campo}', '${6:Validação, padrão ou efeito}']",
      "  ],",
      "  observacoes: ['${7:Explique como preencher valores e limitações do modelo}'],",
      "  fontes: ['${8:docs/assets/caminho/UNIT_CONSUMIDORA.pas}']",
      "},$0"
    ]
  },
  "Estado da documentação": {
    "scope": "typescript",
    "prefix": "docestado",
    "description": "Substitua o campo estado existente. validado-no-erp exige docvalidacao.",
    "body": [
      "estado: '${1|em-desenvolvimento,em-uso,legado,validado-no-erp|}',$0"
    ]
  },
  "Evidência de validação no ERP": {
    "scope": "typescript",
    "prefix": "docvalidacao",
    "description": "Evidência real obrigatória com estado validado-no-erp, em página ou criarDocumentoUnit.",
    "body": [
      "evidenciaValidacao: {",
      "  data: '${1:AAAA-MM-DD}', versaoERP: '${2:Versão efetivamente validada}',",
      "  referencia: '${3:Link do relatório ou registro de homologação}'",
      "},$0"
    ]
  },
  "Navegação de caso de teste": {
    "scope": "typescript",
    "prefix": "doccaso",
    "description": "Inclua em criarDocumentoUnit do caso; Casos de teste não possui subgrupos.",
    "body": [
      "navegacao: { grupo: 'casos', ordem: ${1:0} },$0"
    ]
  },
  "Fonte de referência": {
    "scope": "typescript",
    "prefix": "docfonte",
    "description": "Entrada da lista fontes; caminho real relativo à raiz do repositório.",
    "body": [
      "{ caminho: '${1:docs/assets/caminho/UNIT.pas}' },$0"
    ]
  },
  "Alias de artefato para a busca": {
    "scope": "typescript",
    "prefix": "docaliasartefato",
    "description": "Inclua em criarDocumentoUnit; o nome declarado deve existir em estados.",
    "body": [
      "aliasesArtefatos: { ${1:CDSCasosTestes}: ['${2:FCDSCasosTestes}'] },$0"
    ]
  },
  "Posicionamento no drawer": {
    "scope": "typescript",
    "prefix": "docnavegacao",
    "description": "IDs registrados: units/setup, constantes, persistencia ou irunner; helpers/gerais ou sincronizacao; mapeamentos/financeiro. Casos não tem subgrupo.",
    "body": [
      "navegacao: { grupo: '${1:units}', subgrupo: '${2:setup}', ordem: ${3:0} },$0"
    ]
  },
  "Grupo de navegação": {
    "scope": "typescript",
    "prefix": "docgrupo",
    "description": "Inclua em GRUPOS_NAVEGACAO de app/content/navegacao.ts; páginas escolhem estes IDs.",
    "body": [
      "{ id: '${1:novo-grupo}', titulo: '${2:Novo grupo}', icone: '${3:mdi-folder-outline}',",
      "  subgrupos: [{ id: '${4:geral}', titulo: '${5:Geral}' }] },$0"
    ]
  },
  "Subgrupo de navegação": {
    "scope": "typescript",
    "prefix": "docsubgrupo",
    "description": "Inclua no array subgrupos do grupo em content/navegacao.ts.",
    "body": [
      "{ id: '${1:novo-subgrupo}', titulo: '${2:Novo subgrupo}' },$0"
    ]
  }
}
